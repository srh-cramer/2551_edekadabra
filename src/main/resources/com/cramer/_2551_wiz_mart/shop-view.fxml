<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cramer._2551_wiz_mart.controller.ShopController">

    <top>
        <VBox>
            <padding>
                <Insets bottom="10" left="15" right="15" top="15" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Wiz-Mart" />

                <Label fx:id="productCountLabel" text="Products: 0" />

                <Label fx:id="cartCountLabel" text="Shopping Cart: 0" HBox.hgrow="ALWAYS" />

                <Button onAction="#handleClearCart" text="Clear Cart" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding>
                    <Insets bottom="5" top="15" />
                </padding>

                <Label text="Search:" />

                <TextField fx:id="searchField" onAction="#handleSearch" promptText="Product name ..." HBox.hgrow="ALWAYS" />

                <Label text="Category:" />

                <ComboBox fx:id="categoryComboBox" prefWidth="150" />

                <Label text="Sort:" />

                <ComboBox fx:id="sortComboBox" prefWidth="150" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox prefWidth="834.0" spacing="10">
            <padding>
                <Insets bottom="10" left="15" right="15" top="10" />
            </padding>

            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Products" />

            <FlowPane fx:id="productPane" hgap="15" prefWrapLength="700" vgap="15" />
        </VBox>
    </center>

    <right>
        <VBox prefWidth="280" spacing="10">

            <padding>
                <Insets bottom="15" left="10" right="15" top="15" />
            </padding>

            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Shopping Cart" />

            <ListView fx:id="cartListView" VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="10">

                <Label style="-fx-font-weight: bold;" text="Total:" />

                <Label fx:id="totalLabel" style="-fx-font-weight: bold;" text="0,00 €" />
            </HBox>

            <Button maxWidth="Infinity" onAction="#handleCheckout" text="Place Order" />
         <HBox alignment="CENTER" layoutX="20.0" layoutY="473.0" spacing="10">
            <children>
               <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleImport" text="Import Cart ..." HBox.hgrow="ALWAYS" />
               <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleExport" text="Export Cart ..." HBox.hgrow="ALWAYS" />
            </children>
         </HBox>
        </VBox>
    </right>

</BorderPane>
