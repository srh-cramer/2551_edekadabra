<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>

<?import javafx.scene.control.ComboBox?>

<?import javafx.scene.control.Label?>

<?import javafx.scene.control.ListView?>

<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>

<?import javafx.scene.layout.FlowPane?>

<?import javafx.scene.layout.HBox?>

<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cramer._2551_wiz_mart.controller.ShopController">

    <top>
        <VBox>
            <padding>
                <Insets top="15" right="15" bottom="10" left="15"/>
            </padding>

            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label text="Wiz-Mart"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

                <Label fx:id="productCountLabel"
                       text="Products: 0"/>

                <Label fx:id="cartCountLabel"
                       text="Shopping Cart: 0"
                       HBox.hgrow="ALWAYS"/>

                <Button text="Clear Cart"
                        onAction="#handleClearCart"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="15" bottom="5"/>
                </padding>

                <Label text="Search:"/>

                <TextField fx:id="searchField"
                           promptText="Product name ..."
                           HBox.hgrow="ALWAYS"
                           onAction="#handleSearch"/>

                <Label text="Category:"/>

                <ComboBox fx:id="categoryComboBox"
                          prefWidth="150"/>

                <Label text="Sort:"/>

                <ComboBox fx:id="sortComboBox"
                          prefWidth="150"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="15" bottom="10" left="15"/>
            </padding>

            <Label text="Products"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <FlowPane fx:id="productPane"
                      hgap="15"
                      vgap="15"
                      prefWrapLength="700"/>
        </VBox>
    </center>

    <right>
        <VBox spacing="10"
              prefWidth="280">

            <padding>
                <Insets top="15" right="15" bottom="15" left="10"/>
            </padding>

            <Label text="Shopping Cart"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <ListView fx:id="cartListView"
                      VBox.vgrow="ALWAYS"/>

            <HBox spacing="10"
                  alignment="CENTER_RIGHT">

                <Label text="Total:"
                       style="-fx-font-weight: bold;"/>

                <Label fx:id="totalLabel"
                       text="0,00 €"
                       style="-fx-font-weight: bold;"/>
            </HBox>

            <Button text="Place Order"
                    maxWidth="Infinity"
                    onAction="#handleCheckout"/>
        </VBox>
    </right>

</BorderPane>
